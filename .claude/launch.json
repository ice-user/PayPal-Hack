{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "frontend"],
      "port": 5173
    },
    {
      "name": "frontend-api",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:api", "--prefix", "frontend"],
      "port": 5174
    },
    {
      "name": "api",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "uvicorn", "precedent.api:app", "--app-dir", "backend", "--port", "8000"],
      "port": 8000
    }
  ]
}
